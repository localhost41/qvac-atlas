{
  "name": "qvac-atlas-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Evidence-backed QVAC hardware compatibility registry",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test:only",
    "lint": "prettier --check \"scripts/**/*.mjs\" package.json pnpm-workspace.yaml && pnpm -r lint",
    "package:audit": "node scripts/audit-package.mjs",
    "package:local": "node scripts/package-local.mjs",
    "ready:local": "node scripts/ready-local.mjs",
    "test": "pnpm build && pnpm test:only",
    "test:only": "pnpm -r test && node --test scripts/*.test.mjs spikes/runtime/*.test.mjs",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
