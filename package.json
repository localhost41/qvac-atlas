{
  "name": "qvac-atlas-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Evidence-backed QVAC hardware compatibility registry",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test:only",
    "lint": "pnpm -r lint",
    "test": "pnpm build && pnpm test:only",
    "test:only": "pnpm -r test && node --test spikes/runtime/*.test.mjs",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
