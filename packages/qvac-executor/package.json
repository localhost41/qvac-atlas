{
  "name": "@qvac-atlas/qvac-executor",
  "version": "0.1.0",
  "private": true,
  "description": "Dormant isolated QVAC lifecycle executor",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.{js,mjs}\" package.json tsconfig.json",
    "test": "pnpm --filter @qvac-atlas/qvac-resolver build && pnpm --filter @qvac-atlas/probe build && pnpm build && node --test test/**/*.test.js",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@qvac-atlas/qvac-resolver": "workspace:*"
  },
  "devDependencies": {
    "@qvac-atlas/probe": "workspace:*",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
