{
  "name": "@qvac-atlas/qvac-resolver",
  "version": "0.1.0",
  "private": true,
  "description": "Fail-closed project-local QVAC SDK resolver and isolated-child bootstrap",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.{js,mjs}\" package.json tsconfig.json",
    "test": "pnpm build && node --test test/**/*.test.js",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
