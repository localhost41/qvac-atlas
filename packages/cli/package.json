{
  "name": "@qvac-atlas/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Local-only QVAC Atlas report CLI; real execution is release-gated",
  "type": "module",
  "bin": {
    "qvac-atlas": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" package.json tsconfig.json",
    "test": "pnpm --filter @qvac-atlas/cli... build && tsx --test test/**/*.test.ts",
    "typecheck": "pnpm --filter @qvac-atlas/cli... build && tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@qvac-atlas/model-artifact": "workspace:*",
    "@qvac-atlas/probe": "workspace:*",
    "@qvac-atlas/qvac-executor": "workspace:*",
    "@qvac-atlas/qvac-resolver": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5"
  }
}
