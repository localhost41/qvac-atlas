{
  "name": "qvac-atlas",
  "version": "0.1.0",
  "description": "Local-only QVAC Atlas report CLI; real execution is release-gated",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/localhost41/qvac-atlas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/localhost41/qvac-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/localhost41/qvac-atlas/issues"
  },
  "keywords": [
    "qvac",
    "compatibility",
    "hardware",
    "local-first"
  ],
  "bin": {
    "qvac-atlas": "./bundle/bin.js"
  },
  "files": [
    "bundle",
    "schemas",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:bundle": "node scripts/build-bundle.mjs",
    "lint": "prettier --check \"scripts/**/*.mjs\" \"src/**/*.ts\" \"test/**/*.ts\" README.md package.json tsconfig.json",
    "test": "pnpm --filter qvac-atlas... build && tsx --test test/**/*.test.ts",
    "typecheck": "pnpm --filter qvac-atlas... build && tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "@qvac-atlas/model-artifact": "workspace:*",
    "@qvac-atlas/probe": "workspace:*",
    "@qvac-atlas/qvac-executor": "workspace:*",
    "@qvac-atlas/qvac-resolver": "workspace:*",
    "@types/node": "^22.0.0",
    "esbuild": "0.25.12",
    "tsx": "^4.20.5"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
