---
import generatedCatalog from "../../generated/catalog.json";
import Base from "../../layouts/Base.astro";
import { sitePath } from "../../site-path.js";
import type { CatalogData } from "../../types/catalog.js";

export function getStaticPaths() {
  const catalog = generatedCatalog as unknown as CatalogData;
  return [...catalog.reports, ...catalog.fixtures].map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, fixture: entry.report.provenance.kind === "fixture" },
  }));
}

const { entry, fixture } = Astro.props;
const report = entry.report;
const runtime = report.runtime as { node_version?: unknown } | undefined;
const profile = report.profile as { id?: unknown } | undefined;
const result = report.result as { workload_status?: unknown } | undefined;
---

<Base
  title={`${fixture ? "Fixture" : "Evidence"} ${entry.reportId} — QVAC Atlas`}
>
  <a class="back" href={sitePath(fixture ? "/fixtures/" : "/")}
    >← Back to {fixture ? "fixture lab" : "registry"}</a
  >
  <article class="report-detail">
    <p class="eyebrow">{fixture ? "Synthetic fixture" : "Reviewed evidence"}</p>
    <h1>Exact report detail</h1>
    {
      fixture && (
        <aside class="warning" aria-labelledby="fixture-warning-title">
          <strong id="fixture-warning-title">Not a compatibility claim.</strong>
          This report has fixture provenance and cannot contribute to observed,
          reproduced, failure, or mixed claims.
        </aside>
      )
    }

    <dl class="summary detail-summary">
      <div><dt>Report ID</dt><dd class="breakable">{entry.reportId}</dd></div>
      <div><dt>Trusted source key</dt><dd>{entry.sourceKey}</dd></div>
      <div>
        <dt>Source independence</dt><dd>{entry.sourceIndependence}</dd>
      </div>
      <div><dt>Source path</dt><dd>{entry.sourcePath}</dd></div>
      <div><dt>Hardware</dt><dd>{entry.facets.hardware}</dd></div>
      <div><dt>Architecture</dt><dd>{entry.facets.architecture}</dd></div>
      <div><dt>Memory</dt><dd>{entry.facets.memory}</dd></div>
      <div><dt>GPU evidence</dt><dd>{entry.facets.gpu}</dd></div>
      <div><dt>Operating system</dt><dd>{entry.facets.os}</dd></div>
      <div><dt>QVAC SDK</dt><dd>{entry.facets.qvac}</dd></div>
      <div>
        <dt>Node runtime</dt><dd>
          {String(runtime?.node_version ?? "unknown")}
        </dd>
      </div>
      <div>
        <dt>Workload profile</dt><dd>
          {String(profile?.id ?? "unknown")}
        </dd>
      </div>
      <div>
        <dt>Requested device</dt><dd>{entry.facets.requestedDevice}</dd>
      </div>
      <div>
        <dt>Directly observed device</dt><dd>{entry.facets.observedDevice}</dd>
      </div>
      <div><dt>Derived observation</dt><dd>{entry.claim.observation}</dd></div>
      <div><dt>Derived claim</dt><dd>{entry.claim.claim}</dd></div>
      <div>
        <dt>Lifecycle result</dt><dd>
          {String(result?.workload_status ?? "unknown")}
        </dd>
      </div>
    </dl>

    <section aria-labelledby="limits-title">
      <h2 id="limits-title">Evidence limitations</h2>
      <ul>
        <li>
          This evidence applies only to the exact versions and configuration
          below.
        </li>
        <li>
          CPU or GPU is recorded only when directly observed; no graphics API
          name is inferred.
        </li>
        <li>
          One successful report is an observation, not universal hardware
          support.
        </li>
        {
          entry.sourceIndependence === "unverified-anonymous" && (
            <li>
              This accountless submission is not identity-verified and cannot
              establish an independent reproduction, even alongside other
              anonymous reports.
            </li>
          )
        }
        <li>
          Hardware and software fields can form an identifying fingerprint.
        </li>
      </ul>
    </section>

    <section aria-labelledby="derivation-title">
      <h2 id="derivation-title">Why Atlas derived this result</h2>
      <ul>
        {
          entry.claim.reasons.map((reason) => (
            <li>
              <code>{reason}</code>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="json-title">
      <h2 id="json-title">Validated report JSON</h2>
      <p>
        Displayed as inert text. Contributor-supplied markup is never executed.
      </p>
      <pre tabindex="0"><code>{JSON.stringify(report, null, 2)}</code></pre>
    </section>
  </article>
</Base>
