---
import generatedCatalog from "../generated/catalog.json";
import CatalogList from "../components/CatalogList.astro";
import Base from "../layouts/Base.astro";
import { sitePath } from "../site-path.js";
import type {
  ActualDeviceClaim,
  CatalogData,
  ObservationState,
} from "../types/catalog.js";

const catalog = generatedCatalog as unknown as CatalogData;
const slugs = new Map(
  catalog.reports.map((entry) => [entry.reportId, entry.slug]),
);
const reports = new Map(
  catalog.reports.map((entry) => [entry.reportId, entry]),
);
const observationOrder: ObservationState[] = [
  "success",
  "fallback",
  "failure",
  "inconclusive",
];
const actualDeviceOrder: ActualDeviceClaim[] = [
  "observed-success",
  "reproduced-success",
];
const claims = catalog.claims.map((entry) => {
  const reportObservations = observationOrder.filter((observation) =>
    entry.reportIds.some(
      (reportId) => reports.get(reportId)?.claim.observation === observation,
    ),
  );
  const actualDeviceClaims =
    entry.claim.actual_backend_claim === null
      ? actualDeviceOrder.filter((claim) =>
          entry.reportIds.some(
            (reportId) =>
              reports.get(reportId)?.claim.actual_backend_claim === claim,
          ),
        )
      : [entry.claim.actual_backend_claim];
  return {
    ...entry,
    actualDeviceClaims,
    claim: entry.claim,
    facets: {
      ...entry.facets,
      claimState: entry.claim.claim,
      outcome:
        reportObservations.length === 1
          ? reportObservations[0]!
          : entry.claim.observation,
    },
    fixture: false,
    links: entry.reportIds.flatMap((reportId) => {
      const slug = slugs.get(reportId);
      return slug === undefined
        ? []
        : [{ href: sitePath(`/reports/${slug}/`), label: reportId }];
    }),
    reportCount: entry.reportIds.length,
    reportObservations,
    sourceCount: entry.sourceCount,
    title: entry.facets.hardware,
  };
});
---

<Base title="QVAC Atlas — compatibility registry">
  <section class="hero">
    <p class="eyebrow">Observed evidence, scoped exactly</p>
    <h1>Has QVAC actually run on hardware like yours?</h1>
    <p>
      Atlas publishes reviewed observations for one exact QVAC version,
      workload, operating system, and hardware configuration. It does not
      predict compatibility across versions or devices.
    </p>
  </section>

  {
    claims.length === 0 && (
      <aside class="notice" aria-labelledby="empty-registry-title">
        <h2 id="empty-registry-title">The genuine registry is not open yet</h2>
        <p>
          Production profile admission is disabled until a hash-verified QVAC
          lifecycle succeeds on real hardware. Fixture data remains isolated in
          the fixture lab.
        </p>
      </aside>
    )
  }

  <CatalogList
    entries={claims}
    heading="Compatibility evidence"
    id="genuine-catalog"
  />
</Base>
