---
import { fixtureRegistryEntry } from "../../data/fixture.js";
import Base from "../../layouts/Base.astro";
---

<Base title="Fixture — QVAC Atlas">
  <h1>{fixtureRegistryEntry.label}</h1>
  <p>
    This page demonstrates static-site rendering only. It is not evidence of
    QVAC compatibility and must not be published as a registry claim.
  </p>
  <dl>
    <dt>Illustrative device</dt>
    <dd>{fixtureRegistryEntry.device}</dd>
    <dt>Illustrative QVAC version</dt>
    <dd>{fixtureRegistryEntry.qvacVersion}</dd>
    <dt>Illustrative outcome</dt>
    <dd>{fixtureRegistryEntry.outcome}</dd>
  </dl>
</Base>
