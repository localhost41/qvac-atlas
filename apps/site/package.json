{
  "name": "@qvac-atlas/site",
  "version": "0.0.0",
  "private": true,
  "description": "QVAC Atlas static evidence registry",
  "type": "module",
  "scripts": {
    "build": "pnpm run catalog && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "catalog": "node ../../scripts/build-catalog.mjs",
    "lint": "prettier --plugin=prettier-plugin-astro --check \"src/**/*.{astro,ts}\" \"public/**/*.js\" \"test/**/*.ts\" package.json tsconfig.json astro.config.mjs",
    "test": "pnpm run build && tsx --test test/**/*.test.ts",
    "typecheck": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^22.0.0",
    "astro": "^5.13.7",
    "cross-env": "^10.0.0",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
